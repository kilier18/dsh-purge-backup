{
  "name": "dsh-preset-kit",
  "version": "1.1.90",
  "description": "DeepSeek Harness 预设工具箱：按模型切换提示词预设、批量校准与工作区工具链；默认预设面向国模「小码酱」。求 Star 收藏 ⭐ 如要二开，请查看署名要求部分",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./arena": "./lib/arena/index.js",
    "./arena/store": "./lib/arena/store.js",
    "./arena/ui": "./lib/arena/ui.js",
    "./arena/tools": "./lib/arena/tools.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-preset-kit": "bin/dsh-preset-kit.js"
  },
  "files": [
    "lib",
    "!lib/default-prompt-inject.md",
    "bin",
    "docs",
    "presets",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "build:client": "node scripts/build-client.mjs",
    "postinstall": "node scripts/ensure-profile-bundle.mjs"
  },
  "license": "Apache-2.0",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "prompt-preset",
    "prompt-toolkit",
    "llm-toolkit",
    "harness-toolkit",
    "deepseek-harness",
    "instructions",
    "rules",
    "prompt-eval",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuJunZhiXue/dsh-preset-kit.git"
  },
  "homepage": "https://github.com/YuJunZhiXue/dsh-preset-kit#readme",
  "bugs": {
    "url": "https://github.com/YuJunZhiXue/dsh-preset-kit/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://codeload.github.com/YuJunZhiXue/dsh-preset-kit/tar.gz/refs/heads/master",
      "zip": "https://codeload.github.com/YuJunZhiXue/dsh-preset-kit/zip/refs/heads/master",
      "git": "https://github.com/YuJunZhiXue/dsh-preset-kit.git"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.1-rc.2",
  "dshTargets": [
    "0.2.1-rc.2",
    "0.2.1-rc.5"
  ]
}
